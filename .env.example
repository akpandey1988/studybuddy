# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the app
# bundle, so only publishable config belongs here. The Anthropic key is a
# Cloud Functions secret and must never appear in this file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to talk to a local `firebase emulators:start` instead of the cloud.
EXPO_PUBLIC_FIREBASE_EMULATOR=0
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
