# Copy to .env. EXPO_PUBLIC_* values are inlined into the app bundle, so only
# publishable config belongs here. Firebase config now comes from
# google-services.json at build time, not from here.

# From Firebase console > Authentication > Google > Web SDK configuration.
# The *web* client id is correct even on Android: Firebase validates the
# idToken that Google Sign-In returns against it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to 1 to talk to a local `firebase emulators:start` instead of the cloud.
EXPO_PUBLIC_FIREBASE_EMULATOR=0
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
