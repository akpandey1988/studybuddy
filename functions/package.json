    "test": "npm run build && node --test lib/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  }
}
